{
  "uid": "ssh-probe",
  "title": "SSH Probe - Login & Command Latency",
  "tags": ["probe"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(ssh_probe_connect_success, instance)", "refId": "tpl-host"},
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "type": "stat",
      "title": "SSH login time",
      "description": "Last fresh login: ssh start until the remote shell answered our first command (TCP + key exchange + auth + shell startup). Probed every 10s with multiplexing disabled. Goes empty while failing.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 5, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_connect_duration_seconds{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "connect",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "SSH logout time",
      "description": "Last logout: sending `exit` until the ssh session fully terminated (channel close + teardown). Probed every 10s in the same session as the login probe. Goes empty while failing.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 5, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_logout_duration_seconds{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "logout",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "SSH session",
      "description": "Result of the last login probe. DOWN means a fresh `ssh <target>` did not complete (auth, network, or timeout).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 9, "y": 0, "w": 3, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_connect_success{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "login",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {"type": "value", "options": {"1": {"text": "UP", "color": "green", "index": 0}, "0": {"text": "DOWN", "color": "red", "index": 1}}}
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "cd (last)",
      "description": "Last `cd` latency on the target over the multiplexed connection — connection setup excluded. Probed every 5s.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_command_duration_seconds{instance=\"$host\",command=\"cd\"}",
          "refId": "A",
          "legendFormat": "cd",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "ls (last)",
      "description": "Last `ls` latency on the target over the multiplexed connection — connection setup excluded. Probed every 5s.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_command_duration_seconds{instance=\"$host\",command=\"ls\"}",
          "refId": "A",
          "legendFormat": "ls",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "poetry (last)",
      "description": "Last poetry-invocation latency on the target over the multiplexed connection — connection setup excluded. Probed every 5s.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_command_duration_seconds{instance=\"$host\",command=\"poetry\"}",
          "refId": "A",
          "legendFormat": "poetry",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "mappings": [],
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "SSH login / logout duration (fresh session, every 10s)",
      "description": "login = ssh start until the remote shell answers (TCP + key exchange + auth + shell startup); logout = `exit` until the session fully closes. Same real session, phases timed separately. Gaps mean the probe failed — failed samples are never drawn as zero.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_connect_duration_seconds{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "login"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_logout_duration_seconds{instance=\"$host\"}",
          "refId": "B",
          "legendFormat": "logout"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "scaleDistribution": {"type": "linear"}
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "login"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "logout"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "type": "timeseries",
      "title": "Remote command duration (multiplexed, every 5s)",
      "description": "cd / ls / poetry run on the target over a shared ControlMaster connection, so connection setup is excluded — compare against host load to see interactive latency degrade. Gaps = failed runs.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_command_duration_seconds{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "{{command}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "scaleDistribution": {"type": "linear"}
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "cd"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "ls"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "poetry"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "type": "timeseries",
      "title": "Probe failures (increase over 5m)",
      "description": "How many probe runs failed in the trailing 5 minutes, per probe. Anything above zero deserves a look at the success timeline and the exporter's stderr.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(ssh_probe_connect_failures_total{instance=\"$host\"}[5m])",
          "refId": "A",
          "legendFormat": "login"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(ssh_probe_logout_failures_total{instance=\"$host\"}[5m])",
          "refId": "C",
          "legendFormat": "logout"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(ssh_probe_command_failures_total{instance=\"$host\"}[5m])",
          "refId": "B",
          "legendFormat": "{{command}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "scaleDistribution": {"type": "linear"}
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "cd"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "ls"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "poetry"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "type": "state-timeline",
      "title": "Probe success timeline",
      "description": "Green = last run of that probe succeeded, red = failed. The login row failing alone points at auth; logout failing alone means sessions hang on exit; all rows failing points at the network or a down host.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_connect_success{instance=\"$host\"}",
          "refId": "A",
          "legendFormat": "login"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_logout_success{instance=\"$host\"}",
          "refId": "C",
          "legendFormat": "logout"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ssh_probe_command_success{instance=\"$host\"}",
          "refId": "B",
          "legendFormat": "{{command}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {"type": "value", "options": {"1": {"text": "OK", "color": "green", "index": 0}, "0": {"text": "FAIL", "color": "red", "index": 1}}}
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "custom": {"lineWidth": 0, "fillOpacity": 70, "spanNulls": false}
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      }
    }
  ]
}
